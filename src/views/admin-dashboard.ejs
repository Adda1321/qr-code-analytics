<%- include('partials/head', { title: 'Dashboard' }) %>
<%- include('partials/nav', { active: 'dashboard' }) %>

<div class="container">
  <div class="range-select">
    <label>
      Range:
      <select id="range-select">
        <option value="7">Last 7 days</option>
        <option value="30" selected>Last 30 days</option>
        <option value="90">Last 90 days</option>
      </select>
    </label>
  </div>

  <div class="stat-tiles">
    <div class="stat-tile">
      <div class="value" id="stat-all-time">–</div>
      <div class="label">All-time scans</div>
    </div>
    <div class="stat-tile">
      <div class="value" id="stat-7d">–</div>
      <div class="label">Scans, last 7 days</div>
    </div>
    <div class="stat-tile">
      <div class="value" id="stat-30d">–</div>
      <div class="label">Scans, last 30 days</div>
    </div>
    <div class="stat-tile">
      <div class="value" id="stat-active">–</div>
      <div class="label">Active QR codes</div>
    </div>
  </div>

  <div class="card">
    <h3>Scans over time (all QR codes combined)</h3>
    <div style="height:260px">
      <canvas id="chart-timeline"></canvas>
    </div>
  </div>

  <div class="card">
    <h3>Scans per QR code</h3>
    <div style="height:220px">
      <canvas id="chart-leaderboard"></canvas>
    </div>
  </div>

  <div class="charts-grid">
    <div class="card">
      <h3>Device type</h3>
      <div style="height:200px">
        <canvas id="chart-device"></canvas>
      </div>
    </div>
    <div class="card">
      <h3>Operating system</h3>
      <div style="height:200px">
        <canvas id="chart-os"></canvas>
      </div>
    </div>
    <div class="card">
      <h3>Browser</h3>
      <div style="height:200px">
        <canvas id="chart-browser"></canvas>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script src="/dashboard.js"></script>
<script>
  initDashboard('/api/stats/combined');
</script>
</body>
</html>
