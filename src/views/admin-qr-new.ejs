<%- include('partials/head', { title: 'New QR Code' }) %>
<%- include('partials/nav', { active: 'qr-new' }) %>

<div class="container">
  <div class="card form-card">
    <h3>Create a new QR code</h3>
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <form class="stacked" method="POST" action="/admin/qr">
      <label>
        Label (for your reference)
        <input type="text" name="label" placeholder="e.g. Coffee Shop Sticker" required />
      </label>
      <label>
        Destination URL (your Instagram profile)
        <input type="url" name="destination_url" placeholder="https://instagram.com/yourhandle" required />
      </label>
      <button type="submit" class="btn">Create QR code</button>
    </form>
  </div>
</div>
</body>
</html>
